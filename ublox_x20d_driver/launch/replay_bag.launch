<!-- Regenerates /heading_imu/imu from a bag containing /ublox_x20d/nav_daheading,
     e.g. to try other heading_imu parameters on recorded data. -->
<launch>
  <arg name="bag"/>
  <arg name="delay" default="1.0"/>
  <arg name="heading_config" default="$(find ublox_x20d_driver)/config/heading_imu.yaml"/>

  <node pkg="rosbag" type="play" name="player" output="screen"
        args="--delay=$(arg delay) --topics /ublox_x20d/nav_daheading --bags $(arg bag)"/>

  <node pkg="ublox_x20d_driver" type="heading_imu_node" name="heading_imu" output="screen">
    <rosparam command="load" file="$(arg heading_config)"/>
    <remap from="nav_daheading" to="ublox_x20d/nav_daheading"/>
  </node>
</launch>
