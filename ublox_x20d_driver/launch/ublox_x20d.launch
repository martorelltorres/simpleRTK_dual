<!-- Driver and heading Imu. Every setting lives in the two configuration files; the
     arguments only select which files to load. -->
<launch>
  <arg name="config" default="$(find ublox_x20d_driver)/config/x20d_usb.yaml"/>
  <arg name="heading_config" default="$(find ublox_x20d_driver)/config/heading_imu.yaml"/>

  <node pkg="ublox_x20d_driver" type="ublox_x20d_node" name="ublox_x20d" output="screen" respawn="true" respawn_delay="5">
    <rosparam command="load" file="$(arg config)"/>
  </node>

  <node pkg="ublox_x20d_driver" type="heading_imu_node" name="heading_imu" output="screen" respawn="true">
    <rosparam command="load" file="$(arg heading_config)"/>
    <remap from="nav_daheading" to="ublox_x20d/nav_daheading"/>
  </node>
</launch>
