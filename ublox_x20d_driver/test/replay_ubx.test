<launch>
  <include file="$(find ublox_x20d_driver)/launch/replay_ubx.launch">
    <arg name="file" value="$(find ublox_x20d_driver)/test/data/x20d_sample.ubx"/>
    <arg name="speed" value="5.0"/>
    <arg name="start_delay" value="3.0"/>
  </include>
  <test test-name="replay_ubx" pkg="ublox_x20d_driver" type="replay_checker.py" time-limit="60.0">
    <param name="check_driver_topics" value="true"/>
  </test>
</launch>
