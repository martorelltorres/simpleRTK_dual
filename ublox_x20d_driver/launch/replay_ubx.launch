<!-- Replays a recorded .ubx file through the driver's publishers and heading_imu_node.
     Topics match a live run: /ublox_x20d/{fix,vel,nav_*} and /heading_imu/imu. -->
<launch>
  <arg name="file"/>
  <arg name="speed" default="1.0"/>          <!-- 0 = as fast as possible -->
  <arg name="start_delay" default="1.0"/>
  <arg name="loop" default="false"/>
  <arg name="heading_config" default="$(find ublox_x20d_driver)/config/heading_imu.yaml"/>

  <node pkg="ublox_x20d_driver" type="ubx_file_player_node" name="ublox_x20d" output="screen">
    <param name="file" value="$(arg file)"/>
    <param name="speed" value="$(arg speed)"/>
    <param name="start_delay" value="$(arg start_delay)"/>
    <param name="loop" value="$(arg loop)"/>
  </node>

  <node pkg="ublox_x20d_driver" type="heading_imu_node" name="heading_imu" output="screen">
    <rosparam command="load" file="$(arg heading_config)"/>
    <remap from="nav_daheading" to="ublox_x20d/nav_daheading"/>
  </node>
</launch>
